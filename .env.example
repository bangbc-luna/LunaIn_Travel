APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL="postgres://lunain:lunain@localhost:5434/lunain?sslmode=disable"
# At least 32 bytes each. Fake dev values only.
JWT_SECRET=dev-jwt-secret-dev-jwt-secret-0123456789
CODE_PEPPER=dev-code-pepper-dev-code-pepper-0123456789
GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
MAIL_FROM="LunaIn Travel <no-reply@lunain.vn>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Number of trusted reverse proxies in front of the API (0 = none).
# Required (must be set explicitly) when APP_ENV=prod.
TRUSTED_PROXY_HOPS=0

# S3-compatible storage. Dev values point at the MinIO from docker-compose.
# Required (endpoint, bucket, keys) when APP_ENV=prod.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=lunain
S3_ACCESS_KEY=lunain
S3_SECRET_KEY=lunain-dev-secret
S3_USE_PATH_STYLE=true
# Public files (public/ prefix) are served at PUBLIC_FILE_BASE_URL + "/" + key.
PUBLIC_FILE_BASE_URL=http://localhost:9010/lunain

# Payments. PAYMENT_PROVIDER = payos | fake. Empty: payos when the three keys
# below are set, otherwise fake (dev/test only; APP_ENV=prod requires payos
# with all keys and both URLs). How to create the keys: see the plan-4 appendix
# "Hướng dẫn tạo key PayOS".
PAYMENT_PROVIDER=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Map provider for charter distances. MAP_PROVIDER = goong | fake. Empty: goong
# when GOONG_API_KEY is set, otherwise fake (dev/test only; APP_ENV=prod
# requires goong with a key and an https base URL).
MAP_PROVIDER=
GOONG_API_KEY=
GOONG_BASE_URL=https://rsapi.goong.io
